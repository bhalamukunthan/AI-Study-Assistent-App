# StudyMate AI - Backend Environment Configuration

# Google Gemini API Key (Get yours free from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# AI Model Selection (e.g. gemini-2.5-flash, gemini-1.5-pro, etc.)
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration
DATABASE_URL=sqlite:///./studymate.db

# Storage Directory for uploaded documents
UPLOAD_DIR=./uploads

